%global commit 2c2e67097016521f21c8916d1b914e21eb24e306
%global shortcommit %(echo %{commit} | cut -c1-7)
%global snapdate 20261112
%global debug_package %{nil}

Name:           aic8800d80-firmware
Epoch:          1
Version:        1.0.0^%{snapdate}git%{shortcommit}
Release:        1%{?dist}
Summary:        AIC8800 firmware, usb_modeswitch config and udev rules
BuildArch:      noarch
License:        GPL-2.0-only
URL:            https://github.com/shenmintao/aic8800d80
Source0:        %{url}/archive/%{commit}/aic8800d80-%{commit}.tar.gz

Requires:       /usr/bin/eject
Requires:       usb_modeswitch
# The akmod package generated by kmodtool requires <name>-kmod-common with the
# same version, so this package must provide that name.
Provides:       aic8800d80-kmod-common = %{epoch}:%{version}-%{release}

%description
Firmware files, usb_modeswitch configuration and udev mode-switch rules for
the AIC8800D80 Wi-Fi and Bluetooth adapter. The kernel modules are in the
separate akmod-aic8800d80 package.

%prep
%autosetup -n aic8800d80-%{commit}

%build

%install
install -Dpm0644 aic.rules \
  %{buildroot}/usr/lib/udev/rules.d/90-aic8800-mode-switch.rules

install -Dpm0644 usb_modeswitch/1111_1111 \
  %{buildroot}/etc/usb_modeswitch.d/1111:1111

install -d -m 0755 %{buildroot}/usr/lib/firmware
cp -a fw/aic8800* %{buildroot}/usr/lib/firmware/

%files
/usr/lib/udev/rules.d/90-aic8800-mode-switch.rules
%config(noreplace) /etc/usb_modeswitch.d/1111:1111
/usr/lib/firmware/aic8800*
